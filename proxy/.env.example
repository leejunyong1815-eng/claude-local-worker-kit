# proxy/.env — docker compose(또는 pip 실행 셸)가 읽는다. 복사: cp .env.example .env
PROXY_MASTER_KEY=sk-lab-CHANGE-ME        # 구성원에게 나눠 줄 키. 인증을 안 걸려면 config 의 general_settings 를 지운다
# GB10 노드가 올라오면 채우고 litellm.config.yaml 의 gb10 항목 주석을 푼다
GB10_BASE_URL=http://CHANGE-ME:8000
GB10_MODEL=CHANGE-ME
GB10_API_KEY=none
